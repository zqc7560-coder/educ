# =====================================================================
# 部署环境变量模板（M12）—— 复制为 .env 后填值：cp .env.example .env
# 真实 .env 被 .gitignore 忽略，永不进 git；本模板只有键名与生成方法。
# 权限纪律：chmod 600 .env
# =====================================================================

# ---- MySQL root 口令（compose 建库/健康检查/备份脚本共用）----
# 生成：openssl rand -base64 18
MYSQL_ROOT_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ---- Redis 口令（requirepass，生产必须开）----
# 生成：openssl rand -base64 12
REDIS_PASS=CHANGE-ME-REDIS-PASSWORD

# ---- JWT 签名密钥：必须 >=32 字节（jjwt HS256 弱密钥闸门，M2 实现）----
# 生成：openssl rand -hex 32
LF_JWT_SECRET=REPLACE-WITH-64-HEX-CHARS

# ---- 管理员初始口令（AdminBootstrapRunner 首启创建 admin 账号）----
# 留空=用代码默认 Admin@123（仅课设演示）；生产务必改强口令，
# 首次登录后在「账号设置」改密（改密即全端下线，M2 语义）
LF_ADMIN_PASSWORD=Admin@123
